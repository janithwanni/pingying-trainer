{
  "name": "pinyin-sprint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-data": "node scripts/check-data.js",
    "test": "node --test \"tests/*.test.js\"",
    "verify": "npm run check-data && npm test && npm run build",
    "cf:dev": "vite build && wrangler pages dev dist",
    "cf:deploy": "vite build && wrangler pages deploy dist",
    "kv:create": "wrangler kv namespace create PROGRESS"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "pinyin-pro": "^3.29.5"
  }
}
